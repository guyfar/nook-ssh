#!/usr/bin/env bash
# ============================================
# Nook - SSH jumpbox for humans
# Version: 1.1.0
# ============================================

set -euo pipefail

BRAND_NAME="Nook"
PRIMARY_CMD="nk"
VERSION="1.3.3"
SSH_OPTIONS=(
    -o ConnectTimeout=10
    -o ServerAliveInterval=60
    -o ServerAliveCountMax=3
    -o StrictHostKeyChecking=accept-new
)

XDG_CONFIG_ROOT="${XDG_CONFIG_HOME:-$HOME/.config}"
CONFIG_DIR="${NOOK_CONFIG_DIR:-$XDG_CONFIG_ROOT/nook}"
CONFIG_FILE="$CONFIG_DIR/servers.conf"
HISTORY_FILE="$CONFIG_DIR/.history"
STATUS_FILE="$CONFIG_DIR/.status"

LEGACY_CONFIG_DIR="$HOME/.ssh-manager"
LEGACY_CONFIG_FILE="$LEGACY_CONFIG_DIR/servers.conf"
LEGACY_HISTORY_FILE="$LEGACY_CONFIG_DIR/.history"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
PURPLE='\033[0;35m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

# Semantic palette (Tokyo Night). Opt out with NO_COLOR=1 or NOOK_NO_COLOR=1.
# Sentinel bytes wrap table cells so column(1) can align display widths first,
# then we swap the sentinels for colours. This keeps CJK columns aligned.
S_NAME=$'\001'
S_GROUP=$'\002'
S_TARGET=$'\003'
S_NOTE=$'\004'
S_END=$'\005'
S_HEAD=$'\006'
S_ON=$'\034'
S_OFF=$'\035'
S_STALE=$'\036'
S_UNK=$'\037'

UI_NAME=''
UI_GROUP=''
UI_TARGET=''
UI_NOTE=''
UI_HEADER=''
UI_LABEL=''
UI_ON=''
UI_OFF=''
UI_STALE=''
UI_RESET=''

set_palette() {
    # auto: colour when stdout is a terminal. picker: always colour, because
    # these run inside fzf (--ansi) even though their stdio is a pipe; a plain
    # pipe would otherwise lose all colour when the list is reloaded.
    local mode="${1:-auto}" on=0 truecolor=0
    if [[ -n "${NO_COLOR:-}" || "${NOOK_NO_COLOR:-0}" == 1 ]]; then
        on=0
    elif [[ "$mode" == force || "$mode" == picker ]]; then
        on=1
    else
        [[ -t 1 ]] && on=1
    fi
    UI_NAME=''; UI_GROUP=''; UI_TARGET=''; UI_NOTE=''
    UI_HEADER=''; UI_LABEL=''; UI_ON=''; UI_OFF=''; UI_STALE=''; UI_RESET=''
    [[ "$on" == 1 ]] || return 0
    if [[ "${COLORTERM:-}" == *truecolor* || "${COLORTERM:-}" == *24bit* || "${TERM:-}" == *truecolor* ]]; then
        truecolor=1
    fi
    if [[ "$truecolor" == 1 ]]; then
        UI_NAME=$'\033[1;38;2;125;207;255m'
        UI_GROUP=$'\033[38;2;187;154;247m'
        UI_TARGET=$'\033[38;2;154;165;206m'
        UI_NOTE=$'\033[38;2;115;125;160m'
        UI_HEADER=$'\033[38;2;86;95;137m'
        UI_LABEL=$'\033[38;2;86;95;137m'
        UI_ON=$'\033[38;2;158;206;106m'
        UI_OFF=$'\033[38;2;247;118;142m'
        UI_STALE=$'\033[38;2;224;175;104m'
    else
        UI_NAME=$'\033[1;36m'
        UI_GROUP=$'\033[0;35m'
        UI_TARGET=$'\033[2m'
        UI_NOTE=$'\033[2m'
        UI_HEADER=$'\033[2m'
        UI_LABEL=$'\033[2m'
        UI_ON=$'\033[0;32m'
        UI_OFF=$'\033[0;31m'
        UI_STALE=$'\033[0;33m'
    fi
    UI_RESET=$'\033[0m'
}

print_logo() {
    echo -e "${CYAN}${BOLD}"
    cat <<'EOF'
    _   __            __
   / | / /___  ____  / /__
  /  |/ / __ \/ __ \/ //_/
 / /|  / /_/ / /_/ / ,<
/_/ |_/\____/\____/_/|_|
EOF
    echo -e "${NC}${DIM}  SSH jumpbox for humans${NC}"
}

trim_field() {
    local value="$1"
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    printf '%s' "$value"
}

fail() {
    printf '[x] %s\n' "$*" >&2
    return 1
}

validate_field() {
    local label="$1" value="$2"
    if [[ "$value" == *'|'* || "$value" =~ [[:cntrl:]] ]]; then
        fail "$label cannot contain |, tabs, or line breaks"
        return 1
    fi
}

validate_name() {
    local name="$1"
    [[ -n "$name" ]] || { fail 'name cannot be empty'; return 1; }
    validate_field Name "$name" || return 1
    if [[ "$name" == \#* || "$name" == \[* ]]; then
        fail 'name cannot start with # or ['
        return 1
    fi
}

validate_port() {
    local port="$1"
    if [[ ! "$port" =~ ^[0-9]{1,5}$ ]] || (( 10#$port < 1 || 10#$port > 65535 )); then
        fail 'port must be a number from 1 to 65535'
        return 1
    fi
}

validate_server() {
    local name="$1" host="$2" port="$3" user="$4"
    validate_name "$name" || return 1
    if [[ -z "$host" || "$host" == -* || ! "$host" =~ ^[[:alnum:]_.:%-]+$ ]]; then
        fail 'enter a hostname, IP address, or SSH host alias'
        return 1
    fi
    validate_port "$port" || return 1
    if [[ -z "$user" || "$user" == -* || "$user" =~ [[:space:]@\|] ]]; then
        fail 'enter a username without spaces, @, or |'
        return 1
    fi
    validate_field User "$user"
}

write_default_config() {
    cat > "$CONFIG_FILE" <<'CONF'
# ============================================
# Nook - server catalog
# ============================================
# Format : name | host | port | user | password(optional) | description
# Group  : lines like [group-name]
# Notes  : password empty uses standard SSH authentication
# ============================================

[default]
# prod-web-01 | 1.2.3.4 | 22 | root | yourpass | production web node
CONF
}

migrate_legacy_config() {
    [[ -n "${NOOK_CONFIG_DIR:-}" ]] && return 0

    if [[ -f "$LEGACY_CONFIG_FILE" && ! -f "$CONFIG_FILE" ]]; then
        cp "$LEGACY_CONFIG_FILE" "$CONFIG_FILE"
        echo -e "${DIM}[migrate] imported config from ${LEGACY_CONFIG_FILE}${NC}"
    fi

    if [[ -f "$LEGACY_HISTORY_FILE" && ! -f "$HISTORY_FILE" ]]; then
        cp "$LEGACY_HISTORY_FILE" "$HISTORY_FILE"
        echo -e "${DIM}[migrate] imported history from ${LEGACY_HISTORY_FILE}${NC}"
    fi
}

init() {
    mkdir -p "$CONFIG_DIR"
    migrate_legacy_config

    if [[ ! -f "$CONFIG_FILE" ]]; then
        write_default_config
    fi

    touch "$HISTORY_FILE"
    [[ -f "$STATUS_FILE" ]] || touch "$STATUS_FILE"
    chmod 600 "$CONFIG_FILE" "$HISTORY_FILE" "$STATUS_FILE"
}

show_help() {
    set_palette auto
    local c="$UI_NAME" g="$UI_GROUP" t="$UI_TARGET" l="$UI_LABEL" r="$UI_RESET" b=$'\033[1m'
    print_logo
    echo ""
    echo -e "${b}${BRAND_NAME} v${VERSION}${r}"
    echo ""
    echo -e "${b}Usage${r}"    printf '  %s%-22s%s %s\n' "$c" "${PRIMARY_CMD}" "$r" 'Open the server picker'
    printf '  %s%-22s%s %s\n' "$c" "${PRIMARY_CMD} add [address]" "$r" 'Add a server in two steps'
    printf '  %s%-22s%s %s\n' "$c" "${PRIMARY_CMD} add --advanced" "$r" 'Optional group, note, saved password'
    printf '  %s%-22s%s %s\n' "$c" "${PRIMARY_CMD} <name>" "$r" 'Connect to an exact, unique name'
    printf '  %s%-22s%s %s\n' "$c" "${PRIMARY_CMD} <keyword>" "$r" 'Search and choose a server'
    printf '  %s%-22s%s %s\n' "$c" "${PRIMARY_CMD} list" "$r" 'List servers with last used and status'
    printf '  %s%-22s%s %s\n' "$c" "${PRIMARY_CMD} ping" "$r" 'Check reachability and refresh status'
    printf '  %s%-22s%s %s\n' "$c" "${PRIMARY_CMD} rm" "$r" 'Remove a server'
    printf '  %s%-22s%s %s\n' "$c" "${PRIMARY_CMD} edit" "$r" 'Edit the config file'
    printf '  %s%-22s%s %s\n' "$c" "${PRIMARY_CMD} key" "$r" 'Configure SSH key login'
    printf '  %s%-22s%s %s\n' "$c" "${PRIMARY_CMD} doctor" "$r" 'Show environment diagnostics'
    printf '  %s%-22s%s %s\n' "$c" "${PRIMARY_CMD} version" "$r" 'Show version'
    printf '  %s%-22s%s %s\n' "$c" "${PRIMARY_CMD} help" "$r" 'Show this help'
    echo ""
    echo -e "${b}In the picker${r}"
    printf '  %s%-22s%s %s\n' "$l" 'Enter' "$r" 'connect to the highlighted server'
    printf '  %s%-22s%s %s\n' "$l" 'ctrl-k' "$r" 'install this key as SSH key login'
    printf '  %s%-22s%s %s\n' "$l" 'ctrl-p' "$r" 'check reachability of this server'
    printf '  %s%-22s%s %s\n' "$l" 'ctrl-y' "$r" 'copy the SSH command'
    printf '  %s%-22s%s %s\n' "$l" 'ctrl-e' "$r" 'show full details'
    printf '  %s%-22s%s %s\n' "$l" 'ctrl-d' "$r" 'remove this server'
    printf '  %s%-22s%s %s\n' "$l" 'Tab' "$r" 'toggle the details pane'
    printf '  %s%-22s%s %s\n' "$l" 'ctrl-r' "$r" 're-check all reachability and reload'
    printf '  %s%-22s%s %s\n' "$l" 'Esc' "$r" 'cancel'
    echo ""
    echo -e "${b}Examples${r}"
    printf '  %s\n' "${PRIMARY_CMD} add ubuntu@example.com"
    printf '  %s\n' "${PRIMARY_CMD} add 'ssh ubuntu@example.com -p 2222'"
    echo ""
    echo -e "${b}Config${r}"
    printf '  %s\n' "$CONFIG_FILE"
}

parse_servers() {
    local group="default" line name host port user pass desc line_number=0
    while IFS= read -r line || [[ -n "$line" ]]; do
        line_number=$((line_number + 1))
        line=$(trim_field "$line")
        [[ -z "$line" || "$line" == \#* ]] && continue

        if [[ "$line" =~ ^\[(.+)\]$ ]]; then
            group="${BASH_REMATCH[1]}"
            validate_field Group "$group" || return 1
            continue
        fi

        IFS='|' read -r name host port user pass desc <<< "$line"
        name=$(trim_field "$name")
        host=$(trim_field "$host")
        port=$(trim_field "$port")
        user=$(trim_field "$user")
        pass=$(trim_field "${pass:-}")
        desc=$(trim_field "${desc:-}")

        port=${port:-22}
        user=${user:-root}
        if ! validate_server "$name" "$host" "$port" "$user" ||
            ! validate_field Password "$pass" || ! validate_field Note "$desc"; then
            fail "fix ${CONFIG_FILE}:${line_number} with ${PRIMARY_CMD} edit"
            return 1
        fi
        printf '%s|%s|%s|%s|%s|%s|%s\n' "$group" "$name" "$host" "$port" "$user" "$pass" "$desc"
    done < "$CONFIG_FILE"
}

count_servers() {
    [[ -f "$CONFIG_FILE" ]] || {
        echo 0
        return 0
    }

    local servers
    servers=$(parse_servers) || return 1
    if [[ -z "$servers" ]]; then
        echo 0
    else
        printf '%s\n' "$servers" | awk 'END { print NR }'
    fi
}

now_epoch() {
    printf '%s\n' "${EPOCHSECONDS:-$(date +%s)}"
}

humanize_time() {
    # Render an age in seconds as a compact label, e.g. 45s / 12m / 3h / 2d.
    local seconds="${1:-0}"
    [[ "$seconds" =~ ^[0-9]+$ ]] || seconds=0
    if (( seconds < 60 )); then printf 'now\n'
    elif (( seconds < 3600 )); then printf '%dm\n' $((seconds / 60))
    elif (( seconds < 86400 )); then printf '%dh\n' $((seconds / 3600))
    else printf '%dd\n' $((seconds / 86400))
    fi
}

record_history() {
    local name="$1" now
    now=$(now_epoch)
    local tmp
    tmp=$(mktemp)
    printf '%s\t%s\n' "$name" "$now" > "$tmp"
    # Preserve existing entries (name + optional timestamp) apart from this one.
    awk -F'\t' -v name="$name" 'NF && $1 != name' "$HISTORY_FILE" >> "$tmp" 2>/dev/null || true
    head -20 "$tmp" > "$HISTORY_FILE"
    rm -f "$tmp"
}

get_history_rank() {
    # Ranks also carry the stored epoch (blank for legacy history files).
    local name="$1" line rank=0
    while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        rank=$((rank + 1))
        if [[ "${line%%$'\t'*}" == "$name" ]]; then
            printf '%s|%s\n' "$rank" "${line#*$'\t'}"
            return 0
        fi
    done < "$HISTORY_FILE"
    printf '999|\n'
}

read_status() {
    # Echo "state<TAB>epoch<TAB>ms" for a server, or nothing when unknown.
    local name="$1" line
    [[ -f "$STATUS_FILE" ]] || return 0
    while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        if [[ "${line%%$'\t'*}" == "$name" ]]; then
            printf '%s\n' "${line#*$'\t'}"
            return 0
        fi
    done < "$STATUS_FILE"
}

record_status() {
    local name="$1" state="$2" ms="${3:-}" now tmp
    now=$(now_epoch)
    tmp=$(mktemp)
    printf '%s\t%s\t%s\t%s\n' "$name" "$state" "$now" "$ms" > "$tmp"
    awk -F'\t' -v name="$name" 'NF && $1 != name' "$STATUS_FILE" >> "$tmp" 2>/dev/null || true
    mv "$tmp" "$STATUS_FILE"
    chmod 600 "$STATUS_FILE" 2>/dev/null || true
}

history_age_label() {
    # Relative age of the last connection for this server, or blank when unknown.
    local name="$1" rank_info age
    rank_info=$(get_history_rank "$name")
    age=${rank_info#*|}
    [[ "$age" =~ ^[0-9]+$ ]] || return 0
    humanize_time "$(( $(now_epoch) - age ))"
}

status_label() {
    # Compact state label for the list; '*' marks a stale reading.
    local name="$1" raw state age now stale='' label
    raw=$(read_status "$name") || true
    [[ -n "$raw" ]] || { printf '%s\n' '-'; return 0; }
    state=${raw%%$'\t'*}
    raw=${raw#*$'\t'}
    age=${raw%%$'\t'*}
    now=$(now_epoch)
    [[ "$age" =~ ^[0-9]+$ ]] || age=0
    if (( now - age > 3600 )); then stale='*'; fi
    if [[ "$state" == up ]]; then label='up'; else label='down'; fi
    printf '%s%s\n' "$label" "$stale"
}

status_sentinel() {
    # Sentinel mapped to the row's status colour during alignment.
    case "$1" in
        up) printf '%s' "$S_ON" ;;
        down) printf '%s' "$S_OFF" ;;
        up\*|down\*) printf '%s' "$S_STALE" ;;
        *) printf '%s' "$S_UNK" ;;
    esac
}

status_color() {
    # Pick the palette entry for a status label (green up, red down, amber stale).
    case "$1" in
        up) printf '%s' "$UI_ON" ;;
        down) printf '%s' "$UI_OFF" ;;
        up\*|down\*) printf '%s' "$UI_STALE" ;;
        *) printf '%s' "$UI_LABEL" ;;
    esac
}

server_at_line() {
    local selected_line="$1" servers="$2"
    [[ "$selected_line" =~ ^[1-9][0-9]*$ ]] || { fail 'invalid server selection'; return 1; }
    printf '%s\n' "$servers" | awk -v selected_line="$selected_line" '
        NR == selected_line { print; found = 1 }
        END { exit !found }
    '
}

server_by_name() {
    # Resolve a name back to its full record. Used by keybind actions, which
    # only see the visible name for non-current rows.
    local servers="$1" wanted="$2" record group name host port user pass desc
    while IFS= read -r record; do
        IFS='|' read -r group name host port user pass desc <<< "$record"
        [[ "$name" == "$wanted" ]] || continue
        printf '%s\n' "$record"
        return 0
    done <<< "$servers"
    return 1
}

copy_to_clipboard() {
    # Reads the text to copy from stdin so it can end a pipe.
    local text
    text=$(cat)
    if command -v pbcopy >/dev/null 2>&1; then printf '%s' "$text" | pbcopy
    elif command -v wl-copy >/dev/null 2>&1; then printf '%s' "$text" | wl-copy
    elif command -v xclip >/dev/null 2>&1; then printf '%s' "$text" | xclip -selection clipboard
    elif command -v clip.exe >/dev/null 2>&1; then printf '%s' "$text" | clip.exe
    else
        fail 'no clipboard tool found (pbcopy, wl-copy, xclip, or clip.exe)'
        return 1
    fi
}

render_fzf_preview() {
    local servers record
    servers=$(parse_servers) || return 1
    record=$(server_at_line "$1" "$servers") || return 1
    render_one_card "$record"
}

render_one_card() {
    local record="$1" group name host port user pass desc login
    local raw status_state checked last
    IFS='|' read -r group name host port user pass desc <<< "$record"
    if [[ -n "$pass" ]] && command -v sshpass >/dev/null 2>&1; then
        login='saved password'
    elif [[ -n "$pass" ]]; then
        login='SSH prompt (sshpass is not installed)'
    else
        login='SSH (key, agent, or password prompt)'
    fi
    raw=$(read_status "$name") || true
    if [[ -n "$raw" ]]; then
        status_state=${raw%%$'\t'*}
        raw=${raw#*$'\t'}
        checked=$(humanize_time "$(( $(now_epoch) - ${raw%%$'\t'*} ))")
    else
        status_state='unknown'
    fi
    last=$(history_age_label "$name")
    printf '%s%s%s %s[%s]%s\n' "$UI_NAME" "$name" "$UI_RESET" "$UI_GROUP" "$group" "$UI_RESET"
    printf '%s%s@%s:%s%s\n\n' "$UI_TARGET" "$user" "$host" "$port" "$UI_RESET"
    [[ -z "$desc" ]] || printf '%sNote:%s %s\n\n' "$UI_LABEL" "$UI_RESET" "$desc"
    printf '%sLogin:%s %s\n' "$UI_LABEL" "$UI_RESET" "$login"
    printf '%sStatus:%s %s\n' "$UI_LABEL" "$UI_RESET" "$status_state"
    [[ -z "$checked" ]] || printf '%sChecked:%s %s ago\n' "$UI_LABEL" "$UI_RESET" "$checked"
    [[ -z "$last" ]] || printf '%sLast:%s %s ago\n' "$UI_LABEL" "$UI_RESET" "$last"
    printf '\nSSH command:\n'
    print_ssh_command "$host" "$port" "$user"
}

print_ssh_command() {
    printf '%q ' ssh "${SSH_OPTIONS[@]}" -p "$2"
    printf '%q\n' "$3@$1"
}

format_table() {
    # column handles terminal widths of CJK names; plain spacing remains usable without it.
    if command -v column >/dev/null 2>&1; then
        column -t -s '|'
    else
        awk -F'|' '{ for (i = 1; i <= NF; i++) printf "%s%s", $i, (i == NF ? "\n" : "  ") }'
    fi
}

render_aligned_cells() {
    # Align sentinel-wrapped cells by display width, then colour each cell.
    # Uses only bash expansion + awk so the runtime stays on the minimal toolset.
    local aligned line
    if command -v column >/dev/null 2>&1; then
        aligned=$(column -t -s'|')
    else
        aligned=$(awk -F'|' '{ for (i = 1; i <= NF; i++) printf "%s%s", $i, (i == NF ? ORS : "  ") }')
    fi
    while IFS= read -r line; do
        line=${line//$S_NAME/$UI_NAME}
        line=${line//$S_GROUP/$UI_GROUP}
        line=${line//$S_TARGET/$UI_TARGET}
        line=${line//$S_NOTE/$UI_NOTE}
        line=${line//$S_HEAD/$UI_HEADER}
        line=${line//$S_ON/$UI_ON}
        line=${line//$S_OFF/$UI_OFF}
        line=${line//$S_STALE/$UI_STALE}
        line=${line//$S_UNK/$UI_LABEL}
        line=${line//$S_END/$UI_RESET}
        printf '%s\n' "$line"
    done <<< "$aligned"
}

connect_server() {
    local host="$1" port="$2" user="$3" name="$4" pass="${5:-}" status=0
    record_history "$name"
    printf '%b[connect]%b %s  %s@%s:%s\n\n' "$GREEN" "$NC" "$name" "$user" "$host" "$port"

    if [[ -n "$pass" ]] && command -v sshpass >/dev/null 2>&1; then
        sshpass -p "$pass" ssh "${SSH_OPTIONS[@]}" -p "$port" "${user}@${host}" || status=$?
    else
        ssh "${SSH_OPTIONS[@]}" -p "$port" "${user}@${host}" || status=$?
    fi

    # On a normal exit (or a remote command's own status) do nothing extra;
    # a failed connection in a real terminal offers next steps.
    if (( status != 0 )) && [[ -t 0 && -t 1 ]]; then
        offer_recovery "$host" "$port" "$user" "$name" "$status"
    fi
    return "$status"
}

offer_recovery() {
    # After a failed connection, suggest the most likely fixes instead of just
    # exiting. Never blocks non-interactive runs.
    local host="$1" port="$2" user="$3" name="$4" status="$5" choice
    [[ -t 0 && -t 1 ]] || return 0
    printf '\n' >&2
    printf '%sCould not connect (ssh exit %s).%s\n' "$UI_OFF" "$status" "$UI_RESET" >&2
    printf '  [p] check port reachability\n' >&2
    printf '  [k] set up SSH key login\n' >&2
    printf '  [e] edit this server\n' >&2
    printf '  [c] copy the SSH command\n' >&2
    printf '  [Enter] do nothing\n' >&2
    printf 'Choice: ' >&2
    read -r choice || return 0
    case "$choice" in
        p|P) cmd_ping "$name" ;;
        k|K) cmd_key "$name" ;;
        e|E) cmd_edit ;;
        c|C) print_ssh_command "$host" "$port" "$user" | copy_to_clipboard \
                 && printf '%b[copy]%b ssh command for %s\n' "$GREEN" "$NC" "$name" >&2 ;;
        *)   : ;;
    esac
}

build_picker_table() {
    # Emit `row-id<TAB>coloured display` lines. fzf shows only field 2
    # (--with-nth=2); field 1 is a hidden, never-coloured selector id that
    # maps back to the row number in the parsed catalog.
    local servers="$1"
    local record group name host port user pass desc rank_info rank age marker combined table ids body
    local agestr status idx=0
    combined="0"$'\t'"0"$'\t'"~header"$'\t'"${S_HEAD}  NAME${S_END}|${S_HEAD}GROUP${S_END}|${S_HEAD}USER@HOST:PORT${S_END}|${S_HEAD}NOTE${S_END}|${S_HEAD}LAST${S_END}|${S_HEAD}STATUS${S_END}"$'\n'
    while IFS= read -r record; do
        idx=$((idx + 1))
        IFS='|' read -r group name host port user pass desc <<< "$record"
        rank_info=$(get_history_rank "$name")
        rank=${rank_info%%|*}
        age=${rank_info#*|}
        marker='  '
        [[ "$rank" -ge 6 ]] || marker='• '
        if [[ "$age" =~ ^[0-9]+$ ]]; then
            agestr=$(humanize_time "$(( $(now_epoch) - age ))")
        else
            agestr=''
        fi
        status=$(status_label "$name")
        combined+="${rank}"$'\t'"${idx}"$'\t'"${name}"$'\t'"${S_NAME}${marker}${name}${S_END}|${S_GROUP}[${group}]${S_END}|${S_TARGET}${user}@${host}:${port}${S_END}|${S_NOTE}${desc}${S_END}|${S_NOTE}${agestr}${S_END}|$(status_sentinel "$status")${status}${S_END}"$'\n'
    done <<< "$servers"
    table=$(printf '%s' "$combined" | sort -t$'\t' -k1,1n -k3,3f | cut -f2,3,4)
    ids=$(printf '%s\n' "$table" | cut -f1)
    body=$(printf '%s\n' "$table" | cut -f3 | render_aligned_cells)
    while IFS= read -r id <&3 && IFS= read -r line <&4; do
        printf '%s\t%s\n' "$id" "$line"
    done 3<<< "$ids" 4<<< "$body"
}

select_with_fzf() {
    local filter="${1:-}" action="${2:-connect}" servers table
    servers=$(parse_servers) || return 1
    [[ -n "$servers" ]] || { fail "no servers configured; run: ${PRIMARY_CMD} add"; return 1; }

    set_palette picker
    table=$(build_picker_table "$servers") || return 1

    local preview_cmd selected status fzf_help term_cols=0 preview_window rows_cmd refresh_cmd
    local ping_cmd copy_cmd key_install_cmd delete_cmd
    printf -v preview_cmd '%q __preview {1}' "$0"
    printf -v rows_cmd '%q __rows' "$0"
    printf -v refresh_cmd '%q __ping-refresh' "$0"
    # {1} is the highlighted row id. Silent actions keep the screen clean;
    # ctrl-k and ctrl-d hand the terminal over (fzf `become`) because they prompt.
    printf -v ping_cmd '%q __action-silent ping {1}' "$0"
    printf -v copy_cmd '%q __action-silent copy {1}' "$0"
    printf -v key_install_cmd '%q __action key {1}' "$0"
    printf -v delete_cmd '%q __action delete {1}' "$0"

    # Right-side details pane needs room; fall back to a bottom pane on narrow terminals.
    term_cols=$(stty size 2>/dev/null | awk '{print $2}') || term_cols=0
    [[ "$term_cols" =~ ^[0-9]+$ ]] || term_cols=${COLUMNS:-0}
    if (( term_cols >= 100 )); then
        preview_window='right,50%,border-left,wrap,hidden'
    else
        preview_window='down,60%,border-top,wrap,hidden'
    fi

    local action_header
    if (( term_cols >= 96 )); then
        action_header=$'   Enter connect    ctrl-p ping    ctrl-y copy    ctrl-k key login    ctrl-d delete    ctrl-r refresh\n   Tab / ctrl-e details      Esc cancel'
    elif (( term_cols >= 72 )); then
        action_header='   Enter connect  ·  Tab details  ·  ctrl-p ping  ·  ctrl-y copy'
    else
        action_header='   Enter connect  ·  Tab details'
    fi

    # Everything runs via `execute`, which returns to the picker (fzf redraws
    # afterwards). `become` is avoided because it exits fzf entirely. Actions
    # that prompt re-attach to the terminal themselves.
    # esc closes the preview first and only aborts when no pane is open, so
    # opening details with ctrl-e/Tab is not a one-way trip.
    local binds="tab:toggle-preview,alt-up:preview-up,alt-down:preview-down,esc:close"
    binds+=",ctrl-e:toggle-preview"
    binds+=",ctrl-p:execute-silent($ping_cmd)+reload($rows_cmd)"
    binds+=",ctrl-y:execute-silent($copy_cmd)+change-header( copied SSH command)"
    binds+=",ctrl-k:execute($key_install_cmd)+reload($rows_cmd)"
    binds+=",ctrl-d:execute($delete_cmd)+reload($rows_cmd)"
    binds+=",ctrl-r:execute-silent($refresh_cmd)+reload($rows_cmd)"

    # Options that only newer fzf understands are added after a capability probe.
    local -a fzf_args=(
        --delimiter=$'\t'
        --with-nth=2
        --header-lines=1
        --ansi
        --layout=reverse
        --height=~95%
        --border=rounded
        --pointer='▌'
        --prompt='❯ '
        --no-multi
        --tiebreak=index
        --info=inline-right
        --preview="$preview_cmd"
        --preview-window="$preview_window"
        --bind="$binds"
        --header="$action_header"
        --query="$filter"
        --color='fg:#c0caf5,fg+:#ffffff,hl:#7aa2f7:bold,hl+:#7aa2f7:bold,bg+:#283457,pointer:#7aa2f7,marker:#7aa2f7,prompt:#7dcfff,header:#565f89,border:#3b4261,info:#565f89,label:#7aa2f7,separator:#3b4261,scrollbar:#3b4261'
    )
    fzf_help=$(fzf --help </dev/null 2>/dev/null || true)
    case "$fzf_help" in *--border-label*) fzf_args+=('--border-label= Nook ' '--border-label-pos=3') ;; esac
    case "$fzf_help" in *--preview-label*) fzf_args+=('--preview-label= DETAILS ' '--preview-label-pos=3') ;; esac
    case "$fzf_help" in *--highlight-line*) fzf_args+=(--highlight-line) ;; esac
    case "$fzf_help" in *--scrollbar*) fzf_args+=(--scrollbar='▐') ;; esac
    case "$fzf_help" in *--separator*) fzf_args+=(--separator='─') ;; esac

    if selected=$(printf '%s\n' "$table" | \
        FZF_DEFAULT_OPTS='' FZF_DEFAULT_OPTS_FILE='' fzf "${fzf_args[@]}"); then
        selected_line="${selected%%$'\t'*}"
        [[ -n "$selected_line" ]] || { fail 'invalid server selection'; return 1; }
        server_at_line "$selected_line" "$servers"
    else
        status=$?
        case "$status" in
            130) return 130 ;;
            1) fail "no server matched; try another keyword or run: ${PRIMARY_CMD} add" ;;
            *) fail "server picker failed; run ${PRIMARY_CMD} doctor and check your fzf installation" ;;
        esac
        return 1
    fi
}

picker_action_record() {
    # Resolve the highlighted row for a keybind action.
    local line_id="$1" servers
    servers=$(parse_servers) || return 1
    server_at_line "$line_id" "$servers"
}

cmd_picker_action_silent() {
    # Side effects only, so the picker screen is never polluted.
    local key="$1" line_id="$2"
    local record group name host port user pass desc
    record=$(picker_action_record "$line_id") || return 1
    IFS='|' read -r group name host port user pass desc <<< "$record"
    case "$key" in
        ping) cmd_ping "$name" >/dev/null 2>&1 ;;
        copy) print_ssh_command "$host" "$port" "$user" | copy_to_clipboard ;;
        *)    fail "unknown silent action '$key'" ;;
    esac
}

cmd_picker_action() {
    # Handoff actions run after fzf releases the terminal (fzf's `become`).
    # fzf may leave stdin non-blocking, so this re-attaches to the controlling
    # terminal before prompting; otherwise `read` fails with EAGAIN.
    local key="$1" line_id="$2"
    local record group name host port user pass desc choice status
    record=$(picker_action_record "$line_id") || { fail 'invalid server selection'; return 1; }
    IFS='|' read -r group name host port user pass desc <<< "$record"
    if [[ -e /dev/tty ]]; then
        exec </dev/tty >/dev/tty 2>&1 || true
        stty sane 2>/dev/null || true
    fi
    case "$key" in
        key)
            printf '%b[key]%b install SSH key for %s\n\n' "$GREEN" "$NC" "$name"
            setup_ssh_key "$host" "$port" "$user" "$pass"
            status=$?
            printf '\nPress Enter to return to Nook... '
            read -r choice || true
            return "$status"
            ;;
        delete)
            printf 'Remove %s (%s)? [y/N]: ' "$name" "$host"
            read -r choice || choice=''
            if [[ "$choice" =~ ^[yY]$ ]]; then
                delete_entry_from_config "$record"
                printf '%b[ok]%b removed %s\n' "$GREEN" "$NC" "$name"
            else
                printf 'cancelled\n'
            fi
            ;;
        *)
            fail "unknown handoff action '$key'"
            ;;
    esac
}

select_fallback() {
    local filter="${1:-}" action="${2:-connect}" servers
    servers=$(parse_servers) || return 1
    [[ -n "$servers" ]] || { fail "no servers configured; run: ${PRIMARY_CMD} add"; return 1; }

    local -a records=()
    local record group name host port user pass desc idx=0 choice rows='#|NAME|GROUP|USER@HOST:PORT|NOTE' row
    printf 'Nook — choose a server to %s\n' "$action" >&2
    while IFS= read -r record; do
        IFS='|' read -r group name host port user pass desc <<< "$record"
        if [[ -n "$filter" ]] && ! printf '%s\n' "$name $host $user $desc $group" | grep -Fqi -- "$filter"; then
            continue
        fi
        records+=("$record")
        idx=$((idx + 1))
        printf -v row '%s)|%s|[%s]|%s@%s:%s|%s' "$idx" "$name" "$group" "$user" "$host" "$port" "$desc"
        rows+=$'\n'"$row"
    done <<< "$servers"

    [[ "$idx" -gt 0 ]] || { fail 'no server matched; try another keyword'; return 1; }
    printf '%s\n' "$rows" | format_table >&2
    printf 'Pick [1-%s], or Enter to cancel: ' "$idx" >&2
    read -r choice || return 130
    [[ -n "$choice" && "$choice" != q ]] || return 130
    if [[ "$choice" =~ ^[0-9]{1,9}$ ]] && (( 10#$choice >= 1 && 10#$choice <= idx )); then
        printf '%s\n' "${records[$((10#$choice - 1))]}"
    else
        fail "enter a number from 1 to ${idx}"
    fi
}

select_server() {
    if command -v fzf >/dev/null 2>&1; then
        select_with_fzf "${1:-}" "${2:-connect}"
    else
        select_fallback "${1:-}" "${2:-connect}"
    fi
}

cmd_connect() {
    local filter="${1:-}" servers record group name host port user pass desc
    local matches=0 result='' status
    servers=$(parse_servers) || return 1
    if [[ -z "$servers" ]]; then
        if [[ -z "$filter" && -t 0 ]]; then
            printf 'No servers yet. Add your first one.\n'
            cmd_add
        else
            fail "no servers configured; run: ${PRIMARY_CMD} add"
        fi
        return
    fi

    if [[ -n "$filter" ]]; then
        while IFS= read -r record; do
            IFS='|' read -r group name host port user pass desc <<< "$record"
            if [[ "$name" == "$filter" ]]; then
                matches=$((matches + 1))
                result="$record"
            fi
        done <<< "$servers"
    fi
    if [[ "$matches" -ne 1 ]]; then
        if result=$(select_server "$filter"); then
            :
        else
            status=$?
            [[ "$status" -ne 130 ]] || return 0
            return "$status"
        fi
    fi
    IFS='|' read -r group name host port user pass desc <<< "$result"
    connect_server "$host" "$port" "$user" "$name" "$pass"
}

insert_entry_into_group() {
    local group="$1" entry="$2"
    local tmp
    tmp=$(mktemp "$CONFIG_DIR/.servers.XXXXXX")

    NOOK_ENTRY="$entry" NOOK_GROUP="$group" awk '
        BEGIN { inserted = 0; group = ENVIRON["NOOK_GROUP"]; entry = ENVIRON["NOOK_ENTRY"] }
        {
            print
            header = $0
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", header)
            if (header == "[" group "]" && inserted == 0) {
                print entry
                inserted = 1
            }
        }
        END {
            if (inserted == 0) {
                if (NR > 0) {
                    print ""
                }
                print "[" group "]"
                print entry
            }
        }
    ' "$CONFIG_FILE" > "$tmp"

    mv "$tmp" "$CONFIG_FILE"
}

delete_entry_from_config() {
    local target_record="$1"
    local tmp
    tmp=$(mktemp "$CONFIG_DIR/.servers.XXXXXX")

    if ! NOOK_DELETE_RECORD="$target_record" awk -F'|' '
        BEGIN { target = ENVIRON["NOOK_DELETE_RECORD"]; group = "default"; removed = 0 }
        function trim(value) {
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
            return value
        }
        /^[[:space:]]*$/ { print; next }
        /^[[:space:]]*#/ { print; next }
        {
            line = trim($0)
            if (line ~ /^\[.+\]$/) {
                group = substr(line, 2, length(line) - 2)
                print
                next
            }
            port = trim($3); if (port == "") port = "22"
            user = trim($4); if (user == "") user = "root"
            candidate = group "|" trim($1) "|" trim($2) "|" port "|" user "|" trim($5) "|" trim($6)
            if (!removed && candidate == target) { removed = 1; next }
            print
        }
        END { exit !removed }
    ' "$CONFIG_FILE" > "$tmp"; then
        rm -f "$tmp"
        fail 'server entry changed; select it again before removing'
        return 1
    fi

    mv "$tmp" "$CONFIG_FILE"
}

parse_address() {
    local input="$1" address='' host port=22 user='' token i=0
    local -a words=()
    [[ -n "$input" ]] || { fail 'address cannot be empty'; return 1; }
    validate_field Address "$input" || return 1
    # Split the supported SSH syntax as data. Never evaluate pasted shell input.
    read -r -a words <<< "$input"
    [[ "${words[0]}" != ssh ]] || i=1
    while (( i < ${#words[@]} )); do
        token=${words[$i]}
        case "$token" in
            -p|-l)
                i=$((i + 1))
                (( i < ${#words[@]} )) || { fail "${token} needs a value"; return 1; }
                if [[ "$token" == -p ]]; then port=${words[$i]}; else user=${words[$i]}; fi
                ;;
            -p*) port=${token#-p} ;;
            -l*) user=${token#-l} ;;
            -*) fail "unsupported option ${token}; use [user@]host with optional -p port or -l user"; return 1 ;;
            *)
                [[ -z "$address" ]] || { fail 'enter one SSH address, without a remote command'; return 1; }
                address="$token"
                ;;
        esac
        i=$((i + 1))
    done
    [[ -n "$address" ]] || { fail 'address cannot be empty'; return 1; }
    host="$address"
    if [[ "$address" == *@* ]]; then
        [[ -z "$user" ]] || { fail 'specify the username once, using user@host or -l user'; return 1; }
        user=${address%%@*}
        host=${address#*@}
        [[ -n "$user" ]] || { fail 'username before @ cannot be empty'; return 1; }
    fi
    user=${user:-root}
    if [[ "$host" == \[*\] ]]; then
        host=${host#\[}
        host=${host%\]}
    fi
    if [[ "$host" == *:* && "$host" != *:*:* ]]; then
        fail 'specify the port with -p, for example: ubuntu@example.com -p 2222'
        return 1
    fi
    # Validate the destination here; cmd_add can retry the port independently.
    validate_server "$host" "$host" 22 "$user" || return 1
    printf '%s|%s|%s\n' "$host" "$port" "$user"
}

validate_new_name() {
    local name="$1" servers="$2" existing_group existing_name record
    validate_name "$name" || return 1
    case "$name" in
        add|rm|remove|del|delete|list|ls|l|edit|key|keys|ping|check|doctor|diag|debug|help|--help|-h|version|--version|-v|__preview|__rows|__action|__action-silent|__ping-refresh)
            fail "'${name}' is a command name; choose a different server name"
            return 1
            ;;
    esac
    while IFS='|' read -r existing_group existing_name record; do
        if [[ "$existing_name" == "$name" ]]; then
            fail "a server named '${name}' already exists; choose a different name"
            return 1
        fi
    done <<< "$servers"
}


cmd_add() {
    local advanced=false address parsed host port user name pass='' desc='' group=default
    local servers entry tty_state restore_terminal password_status
    if [[ "${1:-}" == --advanced ]]; then
        advanced=true
        shift
    fi
    servers=$(parse_servers) || return 1
    printf 'Add a server\n'
    if [[ "$advanced" == false ]]; then
        printf 'Optional group, note, saved password: %s add --advanced\n\n' "$PRIMARY_CMD"
    fi
    address="$*"
    while true; do
        if [[ -z "$address" ]]; then
            printf 'Address (user@host or ssh command): ' >&2
            read -r address || return 1
        fi
        address=$(trim_field "$address")
        if parsed=$(parse_address "$address"); then break; fi
        [[ -t 0 ]] || return 1
        address=''
    done
    IFS='|' read -r host port user <<< "$parsed"
    until validate_port "$port"; do
        [[ -t 0 ]] || return 1
        printf 'Port [22]: ' >&2
        read -r port || return 1
        port=$(trim_field "$port")
        port=${port:-22}
    done
    port=$((10#$port))
    printf 'Target: %s@%s:%s\n' "$user" "$host" "$port"

    while true; do
        printf 'Name [%s]: ' "$host" >&2
        read -r name || return 1
        name=$(trim_field "$name")
        name=${name:-$host}
        if validate_new_name "$name" "$servers"; then break; fi
        [[ -t 0 ]] || return 1
    done

    if [[ "$advanced" == true ]]; then
        while true; do
            printf 'Group [default]: ' >&2
            read -r group || return 1
            group=$(trim_field "$group")
            group=${group:-default}
            if validate_field Group "$group"; then
                if [[ "$group" != *'['* && "$group" != *']'* ]]; then break; fi
                printf '[x] group cannot contain [ or ]\n' >&2
            fi
            [[ -t 0 ]] || return 1
        done
        while true; do
            printf 'Note [optional]: ' >&2
            read -r desc || return 1
            desc=$(trim_field "$desc")
            if validate_field Note "$desc"; then break; fi
            [[ -t 0 ]] || return 1
        done
        while true; do
            tty_state=''
            if [[ -t 0 ]]; then
                tty_state=$(stty -g)
                printf -v restore_terminal 'stty %q' "$tty_state"
                trap "$restore_terminal" EXIT
                trap "$restore_terminal; exit 130" INT
                trap "$restore_terminal; exit 143" TERM
                # Hide input before the prompt, even when a password is pasted immediately.
                stty -echo
            fi
            printf 'Save password in config [blank to let SSH handle login]: ' >&2
            if IFS= read -r pass; then password_status=0; else password_status=$?; fi
            if [[ -n "$tty_state" ]]; then
                stty "$tty_state"
                trap - EXIT INT TERM
            fi
            printf '\n' >&2
            [[ "$password_status" -eq 0 ]] || return "$password_status"
            if validate_field Password "$pass"; then
                if [[ "$pass" == "$(trim_field "$pass")" ]]; then break; fi
                printf '[x] saved passwords cannot start or end with whitespace; leave blank to enter the password in SSH\n' >&2
            fi
            [[ -t 0 ]] || return 1
        done
    fi

    printf -v entry '%-18s | %-20s | %-5s | %-10s | %-12s | %s' \
        "$name" "$host" "$port" "$user" "$pass" "$desc"
    insert_entry_into_group "$group" "$entry"
    printf '[ok] Added %s (%s@%s:%s) in [%s]\n' "$name" "$user" "$host" "$port" "$group"
    printf 'Connect: %s %q\n' "$PRIMARY_CMD" "$name"
}

cmd_rm() {
    local servers result status group name host port user pass desc confirm
    servers=$(parse_servers) || return 1
    if [[ -n "${1:-}" ]]; then
        result=$(server_by_name "$servers" "$1") || { fail "no server named '$1'"; return 1; }
    elif result=$(select_server '' remove); then
        :
    else
        status=$?
        [[ "$status" -ne 130 ]] || return 0
        return "$status"
    fi
    IFS='|' read -r group name host port user pass desc <<< "$result"
    printf 'Remove %s (%s)? [y/N]: ' "$name" "$host" >&2
    read -r confirm || return 0
    if [[ "$confirm" =~ ^[yY]$ ]]; then
        delete_entry_from_config "$result"
        printf '[ok] removed %s\n' "$name"
    fi
}

cmd_list() {
    local servers group name host port user pass desc table
    servers=$(parse_servers) || return 1
    [[ -n "$servers" ]] || { printf 'No servers configured; run: %s add\n' "$PRIMARY_CMD"; return 0; }
    set_palette auto
    table=$({
        printf '%sNAME%s|%sGROUP%s|%sUSER@HOST:PORT%s|%sNOTE%s|%sLAST%s|%sSTATUS%s\n' \
            "$S_HEAD" "$S_END" "$S_HEAD" "$S_END" "$S_HEAD" "$S_END" "$S_HEAD" "$S_END" "$S_HEAD" "$S_END" "$S_HEAD" "$S_END"
        while IFS='|' read -r group name host port user pass desc; do
            printf '%s%s%s|%s[%s]%s|%s%s@%s:%s%s|%s%s%s|%s%s%s|%s%s%s\n' \
                "$S_NAME" "$name" "$S_END" \
                "$S_GROUP" "$group" "$S_END" \
                "$S_TARGET" "$user" "$host" "$port" "$S_END" \
                "$S_NOTE" "$desc" "$S_END" \
                "$S_NOTE" "$(history_age_label "$name")" "$S_END" \
                "$(status_sentinel "$(status_label "$name")")" "$(status_label "$name")" "$S_END"
        done <<< "$servers"
    } | render_aligned_cells)
    printf '%s\n' "$table"
    printf '\n%s server(s)\n' "$(printf '%s\n' "$servers" | awk 'END { print NR }')"
}

cmd_edit() {
    local editor="${EDITOR:-vim}"
    echo -e "${DIM}[edit] opening ${CONFIG_FILE} with ${editor}${NC}"
    "$editor" "$CONFIG_FILE"
}

setup_ssh_key() {
    local host="$1" port="$2" user="$3" pass="${4:-}" status
    local key_file="$HOME/.ssh/id_rsa.pub"
    if ! command -v ssh-copy-id >/dev/null 2>&1; then
        fail "ssh-copy-id is not installed; install it and run ${PRIMARY_CMD} key again"
        return 1
    fi

    if [[ ! -f "$key_file" ]]; then
        if [[ -f "$HOME/.ssh/id_ed25519.pub" ]]; then
            key_file="$HOME/.ssh/id_ed25519.pub"
        else
            printf '[init] No SSH public key found; generating ed25519...\n'
            if ssh-keygen -t ed25519 -f "$HOME/.ssh/id_ed25519" -N "" -C "nook@$(hostname)"; then
                key_file="$HOME/.ssh/id_ed25519.pub"
            else
                status=$?
                printf '[x] Key generation failed (exit %s); resolve the error above and retry.\n' "$status" >&2
                return "$status"
            fi
        fi
    fi

    printf '[key] Installing %s on %s@%s:%s\n' "$key_file" "$user" "$host" "$port"
    local -a key_command=(ssh-copy-id -i "$key_file" -p "$port")
    if [[ -n "$pass" ]] && command -v sshpass >/dev/null 2>&1; then
        key_command=(sshpass -p "$pass" "${key_command[@]}" -o StrictHostKeyChecking=accept-new)
    elif [[ -n "$pass" ]]; then
        printf '[info] sshpass is not installed; enter the password when SSH asks.\n' >&2
    fi
    key_command+=("${user}@${host}")
    if "${key_command[@]}"; then
        printf '[ok] SSH key login configured\n'
    else
        status=$?
        printf '[x] Key setup failed (exit %s). The SSH error is shown above.\n' "$status" >&2
        printf 'Check login with: ' >&2
        print_ssh_command "$host" "$port" "$user" >&2
        return "$status"
    fi
}

cmd_key() {
    local servers result status group name host port user pass desc
    servers=$(parse_servers) || return 1
    if [[ -n "${1:-}" ]]; then
        result=$(server_by_name "$servers" "$1") || { fail "no server named '$1'"; return 1; }
    else
        printf 'Configure SSH key login\n'
        if result=$(select_server '' select); then
            :
        else
            status=$?
            [[ "$status" -ne 130 ]] || return 0
            return "$status"
        fi
    fi
    IFS='|' read -r group name host port user pass desc <<< "$result"
    setup_ssh_key "$host" "$port" "$user" "$pass"
}

cmd_ping() {
    # Reachability, not SSH login: writes the cache the picker reads.
    local servers group name host port user pass desc detail status=0
    servers=$(parse_servers) || return 1
    [[ -n "$servers" ]] || { printf 'No servers configured; run %s add\n' "$PRIMARY_CMD"; return 0; }
    if ! command -v nc >/dev/null 2>&1; then
        fail "nc is not installed; install netcat and run ${PRIMARY_CMD} ping again"
        return 1
    fi
    printf 'Direct TCP checks of configured SSH ports; SSH login is not tested.\n'
    printf 'Results are cached for the picker status column.\n\n'
    while IFS='|' read -r group name host port user pass desc; do
        if [[ -n "${1:-}" && "$name" != "$1" ]]; then
            continue
        fi
        printf '%s [%s] %s:%s  ' "$name" "$group" "$host" "$port"
        if detail=$(nc -z -w 3 "$host" "$port" 2>&1); then
            record_status "$name" up ''
            printf '[ok] SSH port reachable\n'
        else
            record_status "$name" down ''
            printf '[x] SSH port not reachable\n'
            [[ -z "$detail" ]] || printf '    %s\n' "$detail" >&2
            status=1
        fi
    done <<< "$servers"
    printf '\nRefresh the picker with ctrl-r.\n'
    return "$status"
}

cmd_ping_refresh() {
    # Quiet refresh used by the picker's ctrl-r binding.
    local servers group name host port user pass desc
    servers=$(parse_servers) || return 1
    command -v nc >/dev/null 2>&1 || { printf 'nc is not installed\n' >&2; return 1; }
    while IFS='|' read -r group name host port user pass desc; do
        if nc -z -w 2 "$host" "$port" >/dev/null 2>&1; then
            record_status "$name" up ''
        else
            record_status "$name" down ''
        fi
    done <<< "$servers"
    printf 'Status refreshed\n' >&2
}

cmd_doctor() {
    local server_count nc_state sshpass_state color_state
    server_count=$(count_servers) || return 1
    command -v nc >/dev/null 2>&1 && nc_state='installed' || nc_state='not installed'
    command -v sshpass >/dev/null 2>&1 && sshpass_state='installed' || sshpass_state='not installed'
    if [[ -n "${NO_COLOR:-}" || "${NOOK_NO_COLOR:-0}" == 1 ]]; then
        color_state='disabled'
    elif [[ "${COLORTERM:-}" == *truecolor* || "${COLORTERM:-}" == *24bit* || "${TERM:-}" == *truecolor* ]]; then
        color_state='truecolor'
    else
        color_state='256 / basic'
    fi
    set_palette auto

    printf '%s%s%s\n\n' "$UI_NAME" "Diagnostics" "$UI_RESET"

    printf '  %s%-18s%s %s\n' "$UI_LABEL" "Version" "$UI_RESET" "${BRAND_NAME} ${VERSION}"
    printf '  %s%-18s%s %s\n' "$UI_LABEL" "Primary command" "$UI_RESET" "${PRIMARY_CMD}"
    printf '  %s%-18s%s %s\n' "$UI_LABEL" "Config dir" "$UI_RESET" "${CONFIG_DIR}"
    printf '  %s%-18s%s %s\n' "$UI_LABEL" "Config file" "$UI_RESET" "${CONFIG_FILE}"
    printf '  %s%-18s%s %s\n' "$UI_LABEL" "History file" "$UI_RESET" "${HISTORY_FILE}"
    printf '  %s%-18s%s %s\n' "$UI_LABEL" "Status cache" "$UI_RESET" "${STATUS_FILE}"
    printf '  %s%-18s%s %s\n' "$UI_LABEL" "Servers" "$UI_RESET" "${server_count}"
    printf '  %s%-18s%s %s\n' "$UI_LABEL" "Colour" "$UI_RESET" "${color_state}"

    if command -v bash >/dev/null 2>&1; then
        printf '  %s%-18s%s %s\n' "$UI_LABEL" "Bash" "$UI_RESET" "$(bash --version | head -1)"
    else
        printf '  %s%-18s%s %s\n' "$UI_LABEL" "Bash" "$UI_RESET" "not found"
    fi

    if command -v ssh >/dev/null 2>&1; then
        printf '  %s%-18s%s %s\n' "$UI_LABEL" "SSH" "$UI_RESET" "$(ssh -V 2>&1)"
    else
        printf '  %s%-18s%s %s\n' "$UI_LABEL" "SSH" "$UI_RESET" "not found"
    fi

    if command -v fzf >/dev/null 2>&1; then
        printf '  %s%-18s%s %s\n' "$UI_LABEL" "fzf" "$UI_RESET" "$(fzf --version </dev/null 2>/dev/null | head -1)"
    else
        printf '  %s%-18s%s %s\n' "$UI_LABEL" "fzf" "$UI_RESET" "not installed"
    fi

    printf '  %s%-18s%s %s\n' "$UI_LABEL" "sshpass" "$UI_RESET" "${sshpass_state}"
    printf '  %s%-18s%s %s\n' "$UI_LABEL" "nc (status)" "$UI_RESET" "${nc_state}"

    if [[ -f "$CONFIG_FILE" ]]; then
        printf '  %s%-18s%s %s\n' "$UI_LABEL" "Config status" "$UI_RESET" "present"
    else
        printf '  %s%-18s%s %s\n' "$UI_LABEL" "Config status" "$UI_RESET" "missing"
    fi
}

main() {
    case "${1:-}" in
        __preview)
            set_palette picker
            render_fzf_preview "${2:-}"
            return 0
            ;;
        __ping-refresh)
            init
            cmd_ping_refresh
            return 0
            ;;
        __rows)
            # Re-emit the picker table for fzf's reload bindings.
            init
            set_palette picker
            build_picker_table "$(parse_servers)"
            return 0
            ;;
        __action)
            # Handoff keybind (fzf `become`): runs after fzf releases the terminal.
            init
            set_palette picker
            cmd_picker_action "${2:-}" "${3:-}"
            return 0
            ;;
        __action-silent)
            # In-place keybind (fzf `execute-silent`): side effects only.
            init
            set_palette picker
            cmd_picker_action_silent "${2:-}" "${3:-}"
            return 0
            ;;
        help|--help|-h)
            show_help
            return 0
            ;;
        version|--version|-v)
            echo "${BRAND_NAME} ${VERSION}"
            return 0
            ;;
        doctor|diag|debug)
            cmd_doctor
            return 0
            ;;
        *)
            init
            ;;
    esac

    case "${1:-}" in
        add)
            shift
            cmd_add "$@"
            ;;
        rm|remove|del|delete)
            cmd_rm
            ;;
        list|ls|l)
            cmd_list
            ;;
        edit)
            cmd_edit
            ;;
        key|keys)
            cmd_key
            ;;
        ping|check)
            cmd_ping
            ;;
        *)
            cmd_connect "${1:-}"
            ;;
    esac
}

main "$@"
