#!/usr/bin/env bash
# ============================================
# Nook - SSH jumpbox for humans
# Version: 1.1.0
# ============================================

set -euo pipefail

BRAND_NAME="Nook"
PRIMARY_CMD="nk"
VERSION="1.1.0"

XDG_CONFIG_ROOT="${XDG_CONFIG_HOME:-$HOME/.config}"
CONFIG_DIR="${NOOK_CONFIG_DIR:-$XDG_CONFIG_ROOT/nook}"
CONFIG_FILE="$CONFIG_DIR/servers.conf"
HISTORY_FILE="$CONFIG_DIR/.history"

LEGACY_CONFIG_DIR="$HOME/.ssh-manager"
LEGACY_CONFIG_FILE="$LEGACY_CONFIG_DIR/servers.conf"
LEGACY_HISTORY_FILE="$LEGACY_CONFIG_DIR/.history"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
PURPLE='\033[0;35m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

print_logo() {
    echo -e "${CYAN}${BOLD}"
    cat <<'EOF'
    _   __            __
   / | / /___  ____  / /__
  /  |/ / __ \/ __ \/ //_/
 / /|  / /_/ / /_/ / ,<
/_/ |_/\____/\____/_/|_|
EOF
    echo -e "${NC}${DIM}  SSH jumpbox for humans${NC}"
}

trim_field() {
    local value="$1"
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    printf '%s' "$value"
}

fail() {
    printf '[x] %s\n' "$*" >&2
    return 1
}

validate_field() {
    local label="$1" value="$2"
    if [[ "$value" == *'|'* || "$value" =~ [[:cntrl:]] ]]; then
        fail "$label cannot contain |, tabs, or line breaks"
        return 1
    fi
}

validate_server() {
    local name="$1" host="$2" port="$3" user="$4"
    [[ -n "$name" ]] || { fail 'name cannot be empty'; return 1; }
    validate_field Name "$name" || return 1
    if [[ "$name" == \#* || "$name" == \[* ]]; then
        fail 'name cannot start with # or ['
        return 1
    fi
    if [[ -z "$host" || "$host" == -* || ! "$host" =~ ^[[:alnum:]_.:%-]+$ ]]; then
        fail 'enter a hostname, IP address, or SSH host alias'
        return 1
    fi
    if [[ ! "$port" =~ ^[0-9]{1,5}$ ]] || (( 10#$port < 1 || 10#$port > 65535 )); then
        fail 'port must be a number from 1 to 65535'
        return 1
    fi
    if [[ -z "$user" || "$user" == -* || "$user" =~ [[:space:]@\|] ]]; then
        fail 'enter a username without spaces, @, or |'
        return 1
    fi
    validate_field User "$user"
}

write_default_config() {
    cat > "$CONFIG_FILE" <<'CONF'
# ============================================
# Nook - server catalog
# ============================================
# Format : name | host | port | user | password(optional) | description
# Group  : lines like [group-name]
# Notes  : password empty uses standard SSH authentication
# ============================================

[default]
# prod-web-01 | 1.2.3.4 | 22 | root | yourpass | production web node
CONF
}

migrate_legacy_config() {
    [[ -n "${NOOK_CONFIG_DIR:-}" ]] && return 0

    if [[ -f "$LEGACY_CONFIG_FILE" && ! -f "$CONFIG_FILE" ]]; then
        cp "$LEGACY_CONFIG_FILE" "$CONFIG_FILE"
        echo -e "${DIM}[migrate] imported config from ${LEGACY_CONFIG_FILE}${NC}"
    fi

    if [[ -f "$LEGACY_HISTORY_FILE" && ! -f "$HISTORY_FILE" ]]; then
        cp "$LEGACY_HISTORY_FILE" "$HISTORY_FILE"
        echo -e "${DIM}[migrate] imported history from ${LEGACY_HISTORY_FILE}${NC}"
    fi
}

init() {
    mkdir -p "$CONFIG_DIR"
    migrate_legacy_config

    if [[ ! -f "$CONFIG_FILE" ]]; then
        write_default_config
    fi

    touch "$HISTORY_FILE"
    chmod 600 "$CONFIG_FILE" "$HISTORY_FILE"
}

show_help() {
    print_logo
    echo ""
    echo -e "${BOLD}${BRAND_NAME} v${VERSION}${NC}"
    echo ""
    echo -e "${BOLD}Usage${NC}"
    echo -e "  ${GREEN}${PRIMARY_CMD}${NC}              Open the server picker"
    echo -e "  ${GREEN}${PRIMARY_CMD} add [address]${NC}  Add a server in two steps"
    echo -e "  ${GREEN}${PRIMARY_CMD} add --advanced${NC} Optional group, note, saved password"
    echo -e "  ${GREEN}${PRIMARY_CMD} rm${NC}           Remove a server"
    echo -e "  ${GREEN}${PRIMARY_CMD} list${NC}         List all servers"
    echo -e "  ${GREEN}${PRIMARY_CMD} edit${NC}         Edit the config file"
    echo -e "  ${GREEN}${PRIMARY_CMD} key${NC}          Configure SSH key login"
    echo -e "  ${GREEN}${PRIMARY_CMD} ping${NC}         Check server reachability"
    echo -e "  ${GREEN}${PRIMARY_CMD} doctor${NC}       Show environment diagnostics"
    echo -e "  ${GREEN}${PRIMARY_CMD} <name>${NC}       Connect to an exact, unique name"
    echo -e "  ${GREEN}${PRIMARY_CMD} <keyword>${NC}    Search and choose a server"
    echo -e "  ${GREEN}${PRIMARY_CMD} version${NC}      Show version"
    echo -e "  ${GREEN}${PRIMARY_CMD} help${NC}         Show this help"
    echo ""
    echo -e "${BOLD}Examples${NC}"
    echo "  ${PRIMARY_CMD} add ubuntu@example.com"
    echo "  ${PRIMARY_CMD} add 'ssh ubuntu@example.com -p 2222'"
    echo ""
    echo -e "${BOLD}Config${NC}"
    echo -e "  ${CONFIG_FILE}"
}

parse_servers() {
    local group="default" line name host port user pass desc line_number=0
    while IFS= read -r line || [[ -n "$line" ]]; do
        line_number=$((line_number + 1))
        line=$(trim_field "$line")
        [[ -z "$line" || "$line" == \#* ]] && continue

        if [[ "$line" =~ ^\[(.+)\]$ ]]; then
            group="${BASH_REMATCH[1]}"
            validate_field Group "$group" || return 1
            continue
        fi

        IFS='|' read -r name host port user pass desc <<< "$line"
        name=$(trim_field "$name")
        host=$(trim_field "$host")
        port=$(trim_field "$port")
        user=$(trim_field "$user")
        pass=$(trim_field "${pass:-}")
        desc=$(trim_field "${desc:-}")

        port=${port:-22}
        user=${user:-root}
        if ! validate_server "$name" "$host" "$port" "$user" ||
            ! validate_field Password "$pass" || ! validate_field Note "$desc"; then
            fail "fix ${CONFIG_FILE}:${line_number} with ${PRIMARY_CMD} edit"
            return 1
        fi
        printf '%s|%s|%s|%s|%s|%s|%s\n' "$group" "$name" "$host" "$port" "$user" "$pass" "$desc"
    done < "$CONFIG_FILE"
}

count_servers() {
    [[ -f "$CONFIG_FILE" ]] || {
        echo 0
        return 0
    }

    local servers
    servers=$(parse_servers) || return 1
    if [[ -z "$servers" ]]; then
        echo 0
    else
        printf '%s\n' "$servers" | awk 'END { print NR }'
    fi
}

record_history() {
    local name="$1"
    local tmp
    tmp=$(mktemp)
    printf '%s\n' "$name" > "$tmp"
    grep -Fvx -- "$name" "$HISTORY_FILE" >> "$tmp" || [[ $? -eq 1 ]]
    head -20 "$tmp" > "$HISTORY_FILE"
    rm -f "$tmp"
}

get_history_rank() {
    local name="$1" item rank=0
    while IFS= read -r item; do
        rank=$((rank + 1))
        if [[ "$item" == "$name" ]]; then
            printf '%s\n' "$rank"
            return 0
        fi
    done < "$HISTORY_FILE"
    printf '999\n'
}

server_at_line() {
    local selected_line="$1" servers="$2"
    [[ "$selected_line" =~ ^[1-9][0-9]*$ ]] || { fail 'invalid server selection'; return 1; }
    printf '%s\n' "$servers" | awk -v selected_line="$selected_line" '
        NR == selected_line { print; found = 1 }
        END { exit !found }
    '
}

render_fzf_preview() {
    local servers record group name host port user pass desc rank
    servers=$(parse_servers) || return 1
    record=$(server_at_line "$1" "$servers") || return 1
    IFS='|' read -r group name host port user pass desc <<< "$record"
    rank=$(get_history_rank "$name")
    printf '%s\n' "$name" "${user}@${host}:${port}" "Group: $group"
    if [[ -n "$pass" ]]; then
        printf 'Login: saved password\n'
    else
        printf 'Login: SSH (key, agent, or password prompt)\n'
    fi
    [[ "$rank" -eq 999 ]] || printf 'Recent: #%s\n' "$rank"
    [[ -z "$desc" ]] || printf '\n%s\n' "$desc"
}

connect_server() {
    local host="$1" port="$2" user="$3" name="$4" pass="${5:-}"
    record_history "$name"
    echo -e "${GREEN}[connect]${NC} ${BOLD}${name}${NC} ${DIM}${user}@${host}:${port}${NC}"
    echo ""

    local ssh_opts=(
        -o ConnectTimeout=10
        -o ServerAliveInterval=60
        -o ServerAliveCountMax=3
        -o StrictHostKeyChecking=accept-new
        -p "$port"
    )

    if [[ -n "$pass" ]] && command -v sshpass >/dev/null 2>&1; then
        sshpass -p "$pass" ssh "${ssh_opts[@]}" "${user}@${host}"
    else
        ssh "${ssh_opts[@]}" "${user}@${host}"
    fi
}

select_with_fzf() {
    local filter="${1:-}" action="${2:-connect}" servers
    servers=$(parse_servers) || return 1
    [[ -n "$servers" ]] || { fail "no servers configured; run: ${PRIMARY_CMD} add"; return 1; }

    # Only a row ID and searchable display text go through fzf, never passwords.
    local rows="" row display record group name host port user pass desc rank idx=0 marker
    while IFS= read -r record; do
        idx=$((idx + 1))
        IFS='|' read -r group name host port user pass desc <<< "$record"
        rank=$(get_history_rank "$name")
        marker=' '
        [[ "$rank" -ge 6 ]] || marker='•'
        printf -v display '%s %-18s  %s@%s:%s  [%s]%s' \
            "$marker" "$name" "$user" "$host" "$port" "$group" "${desc:+  $desc}"
        printf -v row '%s\t%s\t%s' "$rank" "$idx" "$display"
        rows+="$row"$'\n'
    done <<< "$servers"

    local preview_cmd selected status selected_line
    printf -v preview_cmd '%q __preview {1}' "$0"
    if selected=$(printf '%s' "$rows" | sort -t$'\t' -k1,1n -k3,3f | cut -f2- | \
        FZF_DEFAULT_OPTS='' FZF_DEFAULT_OPTS_FILE='' fzf \
            --delimiter=$'\t' \
            --with-nth=2.. \
            --header="Enter ${action} · Tab details · Esc cancel" \
            --prompt='Search > ' \
            --height=~60% \
            --layout=reverse \
            --border=rounded \
            --border-label=' Nook ' \
            --query="$filter" \
            --preview="$preview_cmd" \
            --preview-window='down,6,hidden,wrap' \
            --bind='tab:toggle-preview' \
            --tiebreak=index \
            --no-multi); then
        selected_line=${selected%%$'\t'*}
        server_at_line "$selected_line" "$servers"
    else
        status=$?
        case "$status" in
            130) return 130 ;;
            1) fail "no server matched; try another keyword or run: ${PRIMARY_CMD} add" ;;
            *) fail "server picker failed; run ${PRIMARY_CMD} doctor and check your fzf installation" ;;
        esac
        return 1
    fi
}

select_fallback() {
    local filter="${1:-}" action="${2:-connect}" servers
    servers=$(parse_servers) || return 1
    [[ -n "$servers" ]] || { fail "no servers configured; run: ${PRIMARY_CMD} add"; return 1; }

    local -a records=()
    local record group name host port user pass desc idx=0 choice
    printf 'Nook — choose a server to %s\n' "$action" >&2
    while IFS= read -r record; do
        IFS='|' read -r group name host port user pass desc <<< "$record"
        if [[ -n "$filter" ]] && ! printf '%s\n' "$name $host $user $desc $group" | grep -Fqi -- "$filter"; then
            continue
        fi
        records+=("$record")
        idx=$((idx + 1))
        printf '  %d) %-18s %s@%s:%s [%s]%s\n' \
            "$idx" "$name" "$user" "$host" "$port" "$group" "${desc:+  $desc}" >&2
    done <<< "$servers"

    [[ "$idx" -gt 0 ]] || { fail 'no server matched; try another keyword'; return 1; }
    printf 'Pick [1-%s], or Enter to cancel: ' "$idx" >&2
    read -r choice || return 130
    [[ -n "$choice" && "$choice" != q ]] || return 130
    if [[ "$choice" =~ ^[0-9]{1,9}$ ]] && (( 10#$choice >= 1 && 10#$choice <= idx )); then
        printf '%s\n' "${records[$((10#$choice - 1))]}"
    else
        fail "enter a number from 1 to ${idx}"
    fi
}

select_server() {
    if command -v fzf >/dev/null 2>&1; then
        select_with_fzf "${1:-}" "${2:-connect}"
    else
        select_fallback "${1:-}" "${2:-connect}"
    fi
}

cmd_connect() {
    local filter="${1:-}" servers record group name host port user pass desc
    local matches=0 result='' status
    servers=$(parse_servers) || return 1
    if [[ -z "$servers" ]]; then
        if [[ -z "$filter" && -t 0 ]]; then
            printf 'No servers yet. Add your first one.\n'
            cmd_add
        else
            fail "no servers configured; run: ${PRIMARY_CMD} add"
        fi
        return
    fi

    if [[ -n "$filter" ]]; then
        while IFS= read -r record; do
            IFS='|' read -r group name host port user pass desc <<< "$record"
            if [[ "$name" == "$filter" ]]; then
                matches=$((matches + 1))
                result="$record"
            fi
        done <<< "$servers"
    fi
    if [[ "$matches" -ne 1 ]]; then
        if result=$(select_server "$filter"); then
            :
        else
            status=$?
            [[ "$status" -ne 130 ]] || return 0
            return "$status"
        fi
    fi
    IFS='|' read -r group name host port user pass desc <<< "$result"
    connect_server "$host" "$port" "$user" "$name" "$pass"
}

insert_entry_into_group() {
    local group="$1" entry="$2"
    local tmp
    tmp=$(mktemp "$CONFIG_DIR/.servers.XXXXXX")

    NOOK_ENTRY="$entry" NOOK_GROUP="$group" awk '
        BEGIN { inserted = 0; group = ENVIRON["NOOK_GROUP"]; entry = ENVIRON["NOOK_ENTRY"] }
        {
            print
            header = $0
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", header)
            if (header == "[" group "]" && inserted == 0) {
                print entry
                inserted = 1
            }
        }
        END {
            if (inserted == 0) {
                if (NR > 0) {
                    print ""
                }
                print "[" group "]"
                print entry
            }
        }
    ' "$CONFIG_FILE" > "$tmp"

    mv "$tmp" "$CONFIG_FILE"
}

delete_entry_from_config() {
    local target_record="$1"
    local tmp
    tmp=$(mktemp "$CONFIG_DIR/.servers.XXXXXX")

    if ! NOOK_DELETE_RECORD="$target_record" awk -F'|' '
        BEGIN { target = ENVIRON["NOOK_DELETE_RECORD"]; group = "default"; removed = 0 }
        function trim(value) {
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
            return value
        }
        /^[[:space:]]*$/ { print; next }
        /^[[:space:]]*#/ { print; next }
        {
            line = trim($0)
            if (line ~ /^\[.+\]$/) {
                group = substr(line, 2, length(line) - 2)
                print
                next
            }
            port = trim($3); if (port == "") port = "22"
            user = trim($4); if (user == "") user = "root"
            candidate = group "|" trim($1) "|" trim($2) "|" port "|" user "|" trim($5) "|" trim($6)
            if (!removed && candidate == target) { removed = 1; next }
            print
        }
        END { exit !removed }
    ' "$CONFIG_FILE" > "$tmp"; then
        rm -f "$tmp"
        fail 'server entry changed; select it again before removing'
        return 1
    fi

    mv "$tmp" "$CONFIG_FILE"
}

parse_address() {
    local input="$1" address='' host port=22 user='' token i=0
    local -a words=()
    [[ -n "$input" ]] || { fail 'address cannot be empty'; return 1; }
    validate_field Address "$input" || return 1
    # Split the supported SSH syntax as data. Never evaluate pasted shell input.
    read -r -a words <<< "$input"
    [[ "${words[0]}" != ssh ]] || i=1
    while (( i < ${#words[@]} )); do
        token=${words[$i]}
        case "$token" in
            -p|-l)
                i=$((i + 1))
                (( i < ${#words[@]} )) || { fail "${token} needs a value"; return 1; }
                if [[ "$token" == -p ]]; then port=${words[$i]}; else user=${words[$i]}; fi
                ;;
            -p*) port=${token#-p} ;;
            -l*) user=${token#-l} ;;
            -*) fail "unsupported option ${token}; use [user@]host with optional -p port or -l user"; return 1 ;;
            *)
                [[ -z "$address" ]] || { fail 'enter one SSH address, without a remote command'; return 1; }
                address="$token"
                ;;
        esac
        i=$((i + 1))
    done
    [[ -n "$address" ]] || { fail 'address cannot be empty'; return 1; }
    host="$address"
    if [[ "$address" == *@* ]]; then
        [[ -z "$user" ]] || { fail 'specify the username once, using user@host or -l user'; return 1; }
        user=${address%%@*}
        host=${address#*@}
        [[ -n "$user" ]] || { fail 'username before @ cannot be empty'; return 1; }
    fi
    user=${user:-root}
    if [[ "$host" == \[*\] ]]; then
        host=${host#\[}
        host=${host%\]}
    fi
    if [[ "$host" == *:* && "$host" != *:*:* ]]; then
        fail 'specify the port with -p, for example: ubuntu@example.com -p 2222'
        return 1
    fi
    validate_server "$host" "$host" "$port" "$user" || return 1
    printf '%s|%s|%s\n' "$host" "$((10#$port))" "$user"
}

cmd_add() {
    local advanced=false address parsed host port user name pass='' desc='' group=default
    local servers record existing_group existing_name entry
    if [[ "${1:-}" == --advanced ]]; then
        advanced=true
        shift
    fi
    printf 'Add a server\n'
    if [[ "$advanced" == false ]]; then
        printf 'Optional group, note, saved password: %s add --advanced\n\n' "$PRIMARY_CMD"
    fi
    address="$*"
    if [[ -z "$address" ]]; then
        printf 'Address (user@host or ssh command): ' >&2
        read -r address || return 1
    fi
    address=$(trim_field "$address")
    parsed=$(parse_address "$address") || return 1
    IFS='|' read -r host port user <<< "$parsed"

    printf 'Name [%s]: ' "$host" >&2
    read -r name || return 1
    name=$(trim_field "$name")
    name=${name:-$host}
    validate_server "$name" "$host" "$port" "$user" || return 1
    case "$name" in
        add|rm|remove|del|delete|list|ls|l|edit|key|keys|ping|check|doctor|diag|debug|help|--help|-h|version|--version|-v|__preview)
            fail "'${name}' is a command name; choose a different server name"
            return 1
            ;;
    esac
    servers=$(parse_servers) || return 1
    if [[ -n "$servers" ]]; then
        while IFS='|' read -r existing_group existing_name record; do
            if [[ "$existing_name" == "$name" ]]; then
                fail "a server named '${name}' already exists; choose a different name"
                return 1
            fi
        done <<< "$servers"
    fi

    if [[ "$advanced" == true ]]; then
        printf 'Group [default]: ' >&2
        read -r group || return 1
        group=$(trim_field "$group")
        group=${group:-default}
        validate_field Group "$group" || return 1
        if [[ "$group" == *'['* || "$group" == *']'* ]]; then
            fail 'group cannot contain [ or ]'
            return 1
        fi
        printf 'Note [optional]: ' >&2
        read -r desc || return 1
        desc=$(trim_field "$desc")
        validate_field Note "$desc" || return 1
        printf 'Save password in config [blank to let SSH handle login]: ' >&2
        IFS= read -r -s pass || return 1
        printf '\n' >&2
        validate_field Password "$pass" || return 1
        if [[ "$pass" != "$(trim_field "$pass")" ]]; then
            fail 'saved passwords cannot start or end with whitespace; leave blank to enter the password in SSH'
            return 1
        fi
    fi

    printf -v entry '%-18s | %-20s | %-5s | %-10s | %-12s | %s' \
        "$name" "$host" "$port" "$user" "$pass" "$desc"
    insert_entry_into_group "$group" "$entry"
    printf '[ok] Added %s (%s@%s:%s) in [%s]\n' "$name" "$user" "$host" "$port" "$group"
    printf 'Connect: %s %q\n' "$PRIMARY_CMD" "$name"
}

cmd_rm() {
    local result status group name host port user pass desc confirm
    if result=$(select_server '' remove); then
        :
    else
        status=$?
        [[ "$status" -ne 130 ]] || return 0
        return "$status"
    fi
    IFS='|' read -r group name host port user pass desc <<< "$result"
    printf 'Remove %s (%s)? [y/N]: ' "$name" "$host" >&2
    read -r confirm || return 0
    if [[ "$confirm" =~ ^[yY]$ ]]; then
        delete_entry_from_config "$result"
        printf '[ok] removed %s\n' "$name"
    fi
}

cmd_list() {
    local servers
    servers=$(parse_servers) || return 1
    [[ -z "$servers" ]] && echo -e "${YELLOW}[warn] no servers configured${NC}" && return 0

    local current_group="" idx=0
    while IFS='|' read -r group name host port user pass desc; do
        if [[ "$current_group" != "$group" ]]; then
            current_group="$group"
            echo -e "  ${PURPLE}${BOLD}[$group]${NC}"
        fi

        idx=$((idx + 1))
        local auth="ssh"
        [[ -n "$pass" ]] && auth="pwd"
        printf "    ${GREEN}%-18s${NC} ${DIM}%-16s :%-5s %-8s${NC} %-4s %s\n" \
            "$name" "$host" "$port" "$user" "$auth" "$desc"
    done <<< "$servers"

    echo ""
    echo -e "  ${DIM}${idx} server(s)${NC}"
}

cmd_edit() {
    local editor="${EDITOR:-vim}"
    echo -e "${DIM}[edit] opening ${CONFIG_FILE} with ${editor}${NC}"
    "$editor" "$CONFIG_FILE"
}

setup_ssh_key() {
    local host="$1" port="$2" user="$3" pass="${4:-}"
    local key_file="$HOME/.ssh/id_rsa.pub"

    if [[ ! -f "$key_file" ]]; then
        if [[ -f "$HOME/.ssh/id_ed25519.pub" ]]; then
            key_file="$HOME/.ssh/id_ed25519.pub"
        else
            echo -e "${YELLOW}[init] no SSH public key found, generating ed25519...${NC}"
            ssh-keygen -t ed25519 -f "$HOME/.ssh/id_ed25519" -N "" -C "nook@$(hostname)"
            key_file="$HOME/.ssh/id_ed25519.pub"
        fi
    fi

    echo -e "${DIM}[key] pushing ${key_file} to ${user}@${host}:${port}${NC}"
    if [[ -n "$pass" ]] && command -v sshpass >/dev/null 2>&1; then
        sshpass -p "$pass" ssh-copy-id -o StrictHostKeyChecking=accept-new -i "$key_file" -p "$port" "${user}@${host}" 2>/dev/null && \
            echo -e "${GREEN}[ok]${NC} SSH key login configured" || \
            echo -e "${RED}[x] key setup failed, verify connection or password${NC}"
    else
        ssh-copy-id -i "$key_file" -p "$port" "${user}@${host}" 2>/dev/null && \
            echo -e "${GREEN}[ok]${NC} SSH key login configured" || \
            echo -e "${RED}[x] key setup failed, verify connection or complete it manually${NC}"
    fi
}

cmd_key() {
    local result status group name host port user pass desc
    printf 'Configure SSH key login\n'
    if result=$(select_server '' select); then
        :
    else
        status=$?
        [[ "$status" -ne 130 ]] || return 0
        return "$status"
    fi
    IFS='|' read -r group name host port user pass desc <<< "$result"
    setup_ssh_key "$host" "$port" "$user" "$pass"
}

cmd_ping() {
    local servers
    servers=$(parse_servers) || return 1
    [[ -z "$servers" ]] && echo -e "${YELLOW}[warn] no servers configured${NC}" && return 0

    echo -e "${BOLD}Reachability${NC}"
    echo ""

    while IFS='|' read -r group name host port user pass desc; do
        printf "  %-18s %-16s " "$name" "$host"
        if nc -z -w 3 "$host" "$port" 2>/dev/null; then
            echo -e "${GREEN}[ok] online${NC}"
        else
            echo -e "${RED}[x] offline${NC}"
        fi
    done <<< "$servers"
}

cmd_doctor() {
    local server_count
    server_count=$(count_servers) || return 1

    echo -e "${BOLD}Diagnostics${NC}"
    echo ""

    printf "  %-18s %s\n" "Version" "${BRAND_NAME} ${VERSION}"
    printf "  %-18s %s\n" "Primary command" "${PRIMARY_CMD}"
    printf "  %-18s %s\n" "Config dir" "${CONFIG_DIR}"
    printf "  %-18s %s\n" "Config file" "${CONFIG_FILE}"
    printf "  %-18s %s\n" "History file" "${HISTORY_FILE}"
    printf "  %-18s %s\n" "Servers" "${server_count}"
    printf "  %-18s %s\n" "Shell" "${SHELL:-unknown}"

    if command -v bash >/dev/null 2>&1; then
        printf "  %-18s %s\n" "Bash" "$(bash --version | head -1)"
    else
        printf "  %-18s %s\n" "Bash" "not found"
    fi

    if command -v ssh >/dev/null 2>&1; then
        printf "  %-18s %s\n" "SSH" "$(ssh -V 2>&1)"
    else
        printf "  %-18s %s\n" "SSH" "not found"
    fi

    if command -v fzf >/dev/null 2>&1; then
        printf "  %-18s %s\n" "fzf" "$(fzf --version 2>/dev/null | head -1)"
    else
        printf "  %-18s %s\n" "fzf" "not installed"
    fi

    if command -v sshpass >/dev/null 2>&1; then
        printf "  %-18s %s\n" "sshpass" "installed"
    else
        printf "  %-18s %s\n" "sshpass" "not installed"
    fi

    if [[ -f "$CONFIG_FILE" ]]; then
        printf "  %-18s %s\n" "Config status" "present"
    else
        printf "  %-18s %s\n" "Config status" "missing"
    fi
}

main() {
    case "${1:-}" in
        __preview)
            render_fzf_preview "${2:-}"
            return 0
            ;;
        help|--help|-h)
            show_help
            return 0
            ;;
        version|--version|-v)
            echo "${BRAND_NAME} ${VERSION}"
            return 0
            ;;
        doctor|diag|debug)
            cmd_doctor
            return 0
            ;;
        *)
            init
            ;;
    esac

    case "${1:-}" in
        add)
            shift
            cmd_add "$@"
            ;;
        rm|remove|del|delete)
            cmd_rm
            ;;
        list|ls|l)
            cmd_list
            ;;
        edit)
            cmd_edit
            ;;
        key|keys)
            cmd_key
            ;;
        ping|check)
            cmd_ping
            ;;
        *)
            cmd_connect "${1:-}"
            ;;
    esac
}

main "$@"
